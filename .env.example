# Optional: Node reads this with `node --env-file=.env server/index.js`.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
AUTH_MODE=local
PROVISIONER=disabled
DATA_DIR=./data
# Production requires AUTH_MODE=cognito, PROVISIONER=aws, and HTTPS.
# Terraform generates /opt/navalnyvpn/runtime.json for production configuration.
